{
  "name": "freecode.academy",
  "description": "Source project for freecode.academy",
  "author": "@Fi1osof",
  "license": "MIT",
  "version": "1.6.0",
  "private": true,
  "workspaces": [
    "packages/@prisma-cms/react-hooks",
    "packages/@prisma-cms/component"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development TS_NODE_PROJECT=tsconfig.server.json ts-node-dev --trace-deprecation --ignore-watch=/.next/ --rs --no-notify --respawn --transpile-only server",
    "lint": "eslint . --ext ts --ext tsx --ext js",
    "types": "tsc --pretty --noEmit",
    "types:watch": "tsc --pretty --noEmit --watch",
    "types:server": "yarn types -P tsconfig.server.json",
    "types:server:watch": "yarn types -P tsconfig.server.json --watch",
    "generate": "npm -s run generate:prisma && npm -s run generate:nexus && npm -s run generate:types",
    "generate:prisma": "prisma generate",
    "generate:nexus": "cross-env NODE_ENV=development TS_NODE_PROJECT=tsconfig.server.json ts-node --transpile-only server/nexus",
    "generate:types": "cross-env NODE_PATH=. ts-node -P tsconfig.server.json src/gql/cli/generateTypes/run",
    "prisma:format": "yarn prisma format",
    "prisma:db:push": "cross-env TS_NODE_PROJECT=tsconfig.server.json yarn prisma db push ",
    "prisma:migrate:status": "cross-env TS_NODE_PROJECT=tsconfig.server.json yarn prisma migrate status ",
    "prisma:migrate:create": "cross-env TS_NODE_PROJECT=tsconfig.server.json yarn prisma migrate dev ",
    "prisma:deploy": "yarn prisma migrate deploy ",
    "prisma:seed": "cross-env TS_NODE_PROJECT=tsconfig.server.json yarn prisma db seed ",
    "build": "next build && yarn build:server",
    "build:server": "tsc --project tsconfig.server.json && npm run copy-statics",
    "copy-statics": "copyfiles -u 1 \"server/**/*.graphql\" \"server/**/*.md\" dist/server/",
    "build:analyze": "cross-env ANALYZE=true yarn build",
    "deploy": "yarn prisma:deploy && yarn generate && yarn generate:types",
    "format": "prettier --write .",
    "clean": "rimraf ./dist && rimraf ./.next",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "storybook": "storybook dev -p 6006 -c storybook",
    "build-storybook": "storybook build -c storybook"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "yarn run types"
    }
  },
  "lint-staged": {
    "*.@(ts|tsx)": [
      "yarn lint",
      "yarn format"
    ]
  },
